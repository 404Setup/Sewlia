From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: 404Setup <153366651+404Setup@users.noreply.github.com>
Date: Fri, 1 Nov 2024 21:38:00 +0800
Subject: [PATCH] Ignore compile time warnings


diff --git a/build.gradle.kts b/build.gradle.kts
index 94f89cb3543ad6d7e1a04f41e729ace0d2a683c4..af85c7c6d1b14998ebe837d395dc640df0c33606 100644
--- a/build.gradle.kts
+++ b/build.gradle.kts
@@ -219,6 +219,13 @@ fun TaskContainer.registerRunTask(
     block(this)
 }
 
+tasks.withType<JavaCompile> {
+    val compilerArgs = options.compilerArgs
+    compilerArgs.add("--add-modules=jdk.incubator.vector")
+    compilerArgs.add("-Xlint:-deprecation") // Sewlia
+    options.isWarnings = false // Sewlia
+}
+
 val runtimeClasspathWithoutVanillaServer = configurations.runtimeClasspath.flatMap { it.elements }
     .zip(configurations.vanillaServer.map { it.singleFile.absolutePath }) { runtime, vanilla ->
         runtime.filterNot { it.asFile.absolutePath == vanilla }
