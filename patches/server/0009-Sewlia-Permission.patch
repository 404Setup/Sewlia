Subject: [PATCH] Sewlia Permission


diff --git a/src/main/java/one/tranic/sewlia/Permission.java b/src/main/java/one/tranic/sewlia/Permission.java
new file mode 100644
index 0000000000000000000000000000000000000000..1a397d7c56891ccec79a69377610c6a4874c52c6
--- /dev/null
+++ b/src/main/java/one/tranic/sewlia/Permission.java
@@ -0,0 +1,59 @@
+package one.tranic.sewlia;
+
+import org.bukkit.permissions.PermissionDefault;
+import org.bukkit.util.permissions.DefaultPermissions;
+import org.jetbrains.annotations.NotNull;
+
+public class Permission {
+    private final static String ROOT = "sewlia";
+
+    public static void registerCorePermissions() {
+        org.bukkit.permissions.@NotNull Permission parent = DefaultPermissions.registerPermission(
+                ROOT,
+                "Gives the user the ability to use all Sewlia utilities and commands"
+        );
+
+        setPermission(
+                "command.reload",
+                "Reload Sewlia Config",
+                PermissionDefault.OP,
+                parent
+        );
+        setPermission(
+                "command.tpsbar.self",
+                "Show tpsbar for yourself",
+                PermissionDefault.TRUE,
+                parent
+        );
+        setPermission(
+                "command.tpsbar.another",
+                "Show tpsbar to others",
+                PermissionDefault.OP,
+                parent
+        );
+        setPermission(
+                "command.rambar.self",
+                "Show rambar for yourself",
+                PermissionDefault.TRUE,
+                parent
+        );
+        setPermission(
+                "command.rambar.another",
+                "Show rambar to others",
+                PermissionDefault.OP,
+                parent
+        );
+        setPermission(
+                "feature.tpslocation",
+                "Display player position when using tps command",
+                PermissionDefault.OP,
+                parent
+        );
+
+        parent.recalculatePermissibles();
+    }
+
+    private static void setPermission(@NotNull String permission, @NotNull String desc, @NotNull PermissionDefault def, org.bukkit.permissions.@NotNull Permission parent) {
+        DefaultPermissions.registerPermission(ROOT + "." + permission, desc, def, parent);
+    }
+}
diff --git a/src/main/java/org/bukkit/craftbukkit/CraftServer.java b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
index a8975cee866cf2c617b6d4976df71e5c20cf0e3d..bcc4adf7f781b009000e42edc2e1b649f63f8e87 100644
--- a/src/main/java/org/bukkit/craftbukkit/CraftServer.java
+++ b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
@@ -615,6 +615,7 @@ public final class CraftServer implements Server {
             DefaultPermissions.registerCorePermissions();
             CraftDefaultPermissions.registerCorePermissions();
             if (!io.papermc.paper.configuration.GlobalConfiguration.get().misc.loadPermissionsYmlBeforePlugins) this.loadCustomPermissions(); // Paper
+            one.tranic.sewlia.Permission.registerCorePermissions(); // Sewlia
             this.helpMap.initializeCommands();
             this.syncCommands();
         }
@@ -3201,6 +3202,7 @@ public final class CraftServer implements Server {
         if (!io.papermc.paper.configuration.GlobalConfiguration.get().misc.loadPermissionsYmlBeforePlugins) loadCustomPermissions();
         DefaultPermissions.registerCorePermissions();
         CraftDefaultPermissions.registerCorePermissions();
+        one.tranic.sewlia.Permission.registerCorePermissions(); // Sewlia
     }
 
     @Override
