diff --git a/src/main/java/one/tranic/sewlia/command/CommandUtil.java b/src/main/java/one/tranic/sewlia/command/CommandUtil.java
new file mode 100644
index 0000000000000000000000000000000000000000..d53dcdf04784a31b5571f420f6b2e6eea88faf83
--- /dev/null
+++ b/src/main/java/one/tranic/sewlia/command/CommandUtil.java
@@ -0,0 +1,23 @@
+package one.tranic.sewlia.command;
+
+import net.intelie.tinymap.TinySet;
+import one.tranic.sewlia.Reflect;
+import org.bukkit.Bukkit;
+import org.bukkit.command.Command;
+import org.jetbrains.annotations.Nullable;
+
+import java.io.IOException;
+
+public class CommandUtil {
+    public static void register() {
+        try {
+            @Nullable TinySet<Command> set = Reflect.findAllClass("one.tranic.sewlia.command.mod", Command.class);
+            if (set == null || set.isEmpty()) return;
+            for (Command clazz : set) {
+                Bukkit.getCommandMap().register(clazz.getName(), "minecraft", clazz);
+            }
+        } catch (IOException e) {
+            throw new RuntimeException(e);
+        }
+    }
+}
