diff --git a/src/main/java/one/tranic/sewlia/config/mod/optimization/dab/BlacklistedEntities.java b/src/main/java/one/tranic/sewlia/config/mod/optimization/dab/BlacklistedEntities.java
new file mode 100644
index 0000000000000000000000000000000000000000..3880094d0345606b95dd77b75fc65c5256ccbcd9
--- /dev/null
+++ b/src/main/java/one/tranic/sewlia/config/mod/optimization/dab/BlacklistedEntities.java
@@ -0,0 +1,32 @@
+package one.tranic.sewlia.config.mod.optimization.dab;
+
+import net.minecraft.core.registries.BuiltInRegistries;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.world.entity.EntityType;
+import one.tranic.sewlia.config.annotation.DisableReload;
+
+import java.util.List;
+import java.util.Optional;
+
+public class BlacklistedEntities {
+    @DisableReload
+    public static List<String> value = List.of();
+
+    public static void Do() {
+        if (Enable.value) {
+            for (EntityType<?> entityType : BuiltInRegistries.ENTITY_TYPE) {
+                entityType.dabEnabled = true; // reset all, before setting the ones to true
+            }
+        }
+        if (value.isEmpty()) {
+            value = null;
+            return;
+        }
+        for (String s : value) {
+            Optional<EntityType<?>> v = EntityType.byString(s);
+            if (v.isPresent()) v.get().dabEnabled = false; else MinecraftServer.LOGGER.warn("Unknown entity \"{}\"", s);
+        }
+        try {value.clear();} catch (Exception ignored) {}
+        value = null; // After execution, it is no longer needed, so clear it and set it to null
+    }
+}
