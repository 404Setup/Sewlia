+                        servercore$useCachedParseResults(server.getCommands(), commandSourceStack, this.command);
+                    else server.getCommands().dispatchServerCommand(commandSourceStack, this.command); // CraftBukkit
+                    // Sewlia end - ServerCore optimize Command Block
                 } catch (Throwable var6) {
                     CrashReport crashReport = CrashReport.forThrowable(var6, "Executing command block");
