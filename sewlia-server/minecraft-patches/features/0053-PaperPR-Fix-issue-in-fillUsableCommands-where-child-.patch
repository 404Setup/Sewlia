diff --git a/net/minecraft/commands/Commands.java b/net/minecraft/commands/Commands.java
index 2809e459747be73b3fdd222e6d37ba5e0dce81f5..ee760f48f17ad6f8dbd3d02d2d819d15558cd5b7 100644
--- a/net/minecraft/commands/Commands.java
+++ b/net/minecraft/commands/Commands.java
@@ -565,7 +565,7 @@ public class Commands {
                     }
                     // Diff copied from LiteralCommand#createBuilder
                     for (final CommandNode<SharedSuggestionProvider> child : redirect.getChildren()) {
-                        builder.then(child);
+                        if (child.canUse(source)) builder.then(child); // Sewlia - PaperPR
                     }
 
                     argumentBuilder = builder;
