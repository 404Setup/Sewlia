Subject: [PATCH] PaperPR: Fix issue in fillUsableCommands where child node
 requirements were not checked during redirection command flattening

source: https://github.com/PaperMC/Paper/pull/11953

diff --git a/net/minecraft/commands/Commands.java b/net/minecraft/commands/Commands.java
index 10b8959595cf8e29f094ff831fdeb8c93f3b1455..017cd4146764030971d32032fa05bb3f24f8c5e7 100644
--- a/net/minecraft/commands/Commands.java
+++ b/net/minecraft/commands/Commands.java
@@ -552,7 +552,7 @@ public class Commands {
                     }
                     // Diff copied from LiteralCommand#createBuilder
                     for (CommandNode<SharedSuggestionProvider> child : redirect.getChildren()) {
-                        builder.then(child);
+                        if (child.canUse(source)) builder.then(child); // Sewlia - PaperPR
                     }
 
                     argumentBuilder = builder;
